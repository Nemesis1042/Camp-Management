// Core-Schema, Phase 0/1 – siehe Camp-Management-Solo-Roadmap.md
// Wird in Phase 1-3 um form_fields/form_responses, invoices, guardians etc. erweitert.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MASTER_ADMIN
  CAMP_ADMIN
  STAFF
  PARENT
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  camps     Camp[]
}

model Camp {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  startDate      DateTime
  endDate        DateTime
  maxParticipants Int?
  createdAt      DateTime     @default(now())

  participants   Participant[]
  users          User[]
}

model Participant {
  id         String   @id @default(uuid())
  campId     String
  camp       Camp     @relation(fields: [campId], references: [id])
  firstName  String
  lastName   String
  birthDate  DateTime
  gender     String?
  address    String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Phase 1: guardians, health_info, form_responses (dynamisch, siehe Roadmap)
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  campId       String?
  camp         Camp?    @relation(fields: [campId], references: [id])
  createdAt    DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}
